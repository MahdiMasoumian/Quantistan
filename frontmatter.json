{
  "$schema": "https://frontmatter.codes/frontmatter.schema.json",

  "frontMatter.taxonomy.contentTypes": [
    {
      "name": "tutorials",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        { "title": "Title", "name": "title", "type": "string" },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Date", "name": "date", "type": "datetime" },
        { "title": "Draft", "name": "draft", "type": "draft" },
        { "title": "Slug", "name": "slug", "type": "string" },
        { "title": "Category", "name": "categories", "type": "categories" },
        { "title": "Tags", "name": "tags", "type": "tags" },
        { "title": "Keywords", "name": "keywords", "type": "tags" },
        { "title": "Author", "name": "author", "type": "string", "default": "Mohammad Mahdi Masoumian" },
        { "title": "Show on homepage recent list", "name": "homepage.showRecent", "type": "boolean", "default": true }
      ]
    },
    {
      "name": "publications",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        { "title": "Title", "name": "title", "type": "string" },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Date", "name": "date", "type": "datetime" },
        { "title": "Draft", "name": "draft", "type": "draft" },
        { "title": "Slug", "name": "slug", "type": "string" },
        { "title": "Category", "name": "categories", "type": "categories" },
        { "title": "Tags", "name": "tags", "type": "tags" },
        { "title": "Keywords", "name": "keywords", "type": "tags" },
        { "title": "Author", "name": "author", "type": "string", "default": "Mohammad Mahdi Masoumian" },
        { "title": "Citation Link (DOI/SSRN/Zenodo)", "name": "citation", "type": "string" },
        { "title": "Show on homepage recent list", "name": "homepage.showRecent", "type": "boolean", "default": true }
      ]
    },
    {
      "name": "projects",
      "pageBundle": false,
      "previewPath": null,
      "fields": [
        { "title": "Title", "name": "title", "type": "string" },
        { "title": "Description", "name": "description", "type": "string" },
        { "title": "Date", "name": "date", "type": "datetime" },
        { "title": "Draft", "name": "draft", "type": "draft" },
        { "title": "Slug", "name": "slug", "type": "string" },
        { "title": "Category", "name": "categories", "type": "categories" },
        { "title": "Tags", "name": "tags", "type": "tags" },
        { "title": "Keywords", "name": "keywords", "type": "tags" },
        { "title": "Author", "name": "author", "type": "string", "default": "Mohammad Mahdi Masoumian" },
        { "title": "Citation / Source Link", "name": "citation", "type": "string" },
        { "title": "Show on homepage recent list", "name": "homepage.showRecent", "type": "boolean", "default": true }
      ]
    }
  ],

  "frontMatter.framework.id": "hugo",
  "frontMatter.content.publicFolder": "static",
  "frontMatter.preview.host": "http://localhost:1313",

  "frontMatter.content.pageFolders": [
    {
      "title": "tutorials",
      "path": "[[workspace]]/content/tutorials"
    },
    {
      "title": "publications",
      "path": "[[workspace]]/content/publications"
    },
    {
      "title": "projects",
      "path": "[[workspace]]/content/projects"
    }
  ],

  "frontMatter.git.enabled": true
}